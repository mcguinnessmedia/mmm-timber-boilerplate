{% extends 'layouts/base.twig' %}

{% block content %}
  <section class='not-found'>
    <h1>Sorry, the content you are looking for does not exist.</h1>
    <div class='button-row'>
      <a href='javascript:history.back()' class='button outline'>Go Back</a>
      <a href='{{ site.url }}' class='button'>Go Home</a>
    </div>
  </section>
{% endblock %}