{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="archive archive--{{ archive_type }}">
    <div class="wrapper">
      <h2>{{ title }}</h2>

      {% if posts %}
        <div class="posts-grid">
          {% for post in posts %}
            {# TODO: determine post markup #}
          {% endfor %}
        </div>
      {% else %}
        <p class="no-posts">
          {{ empty_message }}
        </p>
      {% endif %}

      {% if pagination and pagination.pages %}
        <nav class="pagination" aria-label="Archive pagination">
          {% if pagination.prev %}
            <a href="{{ pagination.prev.link }}" class="pagination__prev">&langle; Prev</a>
          {% endif %}

          <div class='page-links'>
            {% for page in pagination.pages %}
              {% if page.link %}
                <a href="{{ page.link }}" class="pagination__link">{{ page.title }}</a>
              {% else %}
                <span class="pagination__link is-current" aria-current="page">{{ page.title }}</span>
              {% endif %}
            {% endfor %}
          </div>

          {% if pagination.next %}
            <a href="{{ pagination.next.link }}" class="pagination__next">Next &rangle;</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  </section>
{% endblock %}